# WhatsApp Configuration
WHATSAPP_SESSION_DIR=./wpp_sessions
WHATSAPP_HEADLESS=false # Set to true in production

# Proxy Configuration
PROXY_ENABLED=false
PROXY_ROTATION_ENABLED=false
PROXY_ROTATION_URL= # API endpoint for rotating IPs
PROXY_LIST= # Comma-separated list of proxies (user:pass@host:port)

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/whatsappbot
MONGO_DB=whatsappbot

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_DELAY_MIN=30000 # 30 seconds
QUEUE_DELAY_MAX=90000 # 90 seconds

# Rate Limiting
COOLDOWN_ENABLED=true
COOLDOWN_MESSAGES=100
COOLDOWN_MINUTES=30

# Spintax Configuration
SPINTAX_ENABLED=true